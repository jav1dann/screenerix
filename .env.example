# Copy to .env.local and fill in.

# Signs session cookies (32+ random characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Unset in development: a random one is generated into .data/auth-secret.
AUTH_SECRET=

# The admin account (full access), created or promoted on server start; a changed password is
# applied on the next start (and signs the admin out everywhere). Password: 8+ characters, 12+ in
# production. Unset: no admin account is created (nothing is generated, logged or written to disk).
# Keep ADMIN_PASSWORD in your host's secret settings, not in a file in the repository.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Where accounts (users.json) and the generated secret live. Default: ./.data
SX_DATA_DIR=

# Session cookies are Secure in production (HTTPS only; http://localhost is fine).
# Serving production over plain HTTP on another host? Set to 1 (not recommended).
AUTH_INSECURE_COOKIE=

# Reverse proxies in front of the app, for per-IP limits on sign-ins (20 failures / 5 min),
# sign-ups (5 / 15 min) and email codes. The client is read from the proxy's end of X-Forwarded-For.
#   1          nginx / Caddy / a load balancer (the proxy must append the client address)
#   2, 3…      that many proxies in a chain (e.g. a CDN in front of nginx)
#   cloudflare Cloudflare's CF-Connecting-IP (only if the origin accepts Cloudflare traffic alone)
# Unset: no proxy trusted — X-Forwarded-For is ignored and limits count per email only.
# Wrong value (e.g. 1 without a proxy): anyone can fake their IP — don't set it without a proxy.
TRUST_PROXY=

# Google Sign-In (OAuth 2.0 / OpenID Connect). Both unset: the "Continue with Google" button is hidden.
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web application),
# then add an Authorized redirect URI for every origin you serve:
#   http://localhost:3000/api/auth/google/callback          (development)
#   https://your-domain.com/api/auth/google/callback        (production)
# Server-side only — never prefix these with NEXT_PUBLIC_. Keep the real values in .env.local, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the app, e.g. https://screenerix.com (scheme + host, no path). Builds the Google
# redirect URI ${AUTH_URL}/api/auth/google/callback — register exactly that in Google Cloud Console —
# the post-login redirect and the payment webhook. REQUIRED in production: under `next start` the
# app only sees its own listen address (http://localhost:3000), never the public domain.
# Unset (local development): the host the browser used, e.g. http://localhost:3000.
AUTH_URL=

# Crypto payments (USDT) through NOWPayments — https://nowpayments.io → Store settings.
# API key and IPN secret are server-side only (never NEXT_PUBLIC_); keep the real values in .env.local.
# Webhooks go to ${AUTH_URL}/api/payments/crypto/webhook, so AUTH_URL must be a public HTTPS origin.
# Without a reachable webhook, open orders are still re-checked with the API every 15 seconds.
# Unset: checkout says crypto payments are unavailable.
PAYMENTS_PROVIDER=nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# 1 (or true): use the NOWPayments sandbox (test keys from the sandbox dashboard). Empty / 0: the
# live API (api.nowpayments.io) — use the live key from the main dashboard; a sandbox key there
# fails with HTTP 403 "Invalid api key" (see the [nowpayments] lines in the server log).
NOWPAYMENTS_SANDBOX=
# Development / tests only: PAYMENTS_PROVIDER=mock fakes addresses, and a webhook signed with
# NOWPAYMENTS_IPN_SECRET stands in for the payment. Refused under NODE_ENV=production unless
# PAYMENTS_ALLOW_MOCK=1 (local `next start` test runs only — never on a real deployment).
PAYMENTS_ALLOW_MOCK=
# Sandbox only: the outcome NOWPayments simulates for new test payments (success, partially_paid).
# Unset: sandbox payments stay "waiting" until you change them in the sandbox dashboard.
NOWPAYMENTS_SANDBOX_CASE=

# Email (verification codes on registration) through Resend — https://resend.com → API Keys.
# Verify your sending domain in Resend first. MAIL_FROM default: Screenerix <support@screenerix.com>.
# Unset in development: codes are printed to the server console instead of emailed.
# Unset in production: email registration is refused (Google sign-in still works).
RESEND_API_KEY=
MAIL_FROM=

# Telegram bot (account linking + alert delivery). Create a bot with @BotFather and paste its token.
# The server long-polls Telegram, so no public URL is needed. Only one process may poll a token at a time.
# Server-side only — never NEXT_PUBLIC_. Read at runtime (no rebuild needed). Unset: Telegram is off.
# On start the server checks it with Telegram: "[telegram] bot @<name> connected" in the log means it works.
TELEGRAM_BOT_TOKEN=
# The bot's username (e.g. ScreenerixBot, without "@"): builds the t.me/<bot>?start=<token> link
# (POST /api/telegram/link-token) and is shown in Account settings. Public — it's in every link.
# Inlined by `next build`: it must be set when the app is BUILT (CI / Docker build args too), and a
# change needs a rebuild. Unset: the server asks Telegram (getMe). If it names a different bot than
# TELEGRAM_BOT_TOKEN's, the log says so and links use the token's real bot.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Tests only: point the bot at a fake Telegram API. Never set in production.
TELEGRAM_API_BASE=

# Web push (alerts with the site closed). Generate once:
#   node -e "const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\nVAPID_PRIVATE_KEY='+k.privateKey)"
# Unset: the Push option in the alert wizard shows as unavailable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com
